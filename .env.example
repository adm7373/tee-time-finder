# Non-secret application defaults
DEFAULT_SEARCH_ZIP=02169

# Cognito configuration. These identify the user pool/app, not a user password.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Base URL of the application (the OAuth redirect URI is derived from this)
BASE_URL=http://localhost:8000

# Cognito hosted UI domain, where /oauth2/authorize and /oauth2/token live.
# e.g. https://tee-time-finder-123456789012.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN_URL=

# OAuth redirect URI. Must match one of the app client's callback_urls exactly
# or Cognito answers with error=redirect_mismatch. Defaults to BASE_URL + "/"
# when left empty.
COGNITO_REDIRECT_URI=http://localhost:8000/
