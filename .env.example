# Non-secret application defaults
DEFAULT_SEARCH_ZIP=02169

# Cognito configuration. These identify the user pool/app, not a user password.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# TeeItUp credentials stored in AWS Secrets Manager.
# Set this to the ARN of the tee-time-finder/teeitup secret created by Terraform.
# Populate the secret value yourself via the AWS Console or CLI:
#   aws secretsmanager put-secret-value \
#     --secret-id tee-time-finder/teeitup \
#     --secret-string '{"username":"...","password":"..."}'
TEEITUP_SECRET_ARN=

# Keep provider credentials out of this file and out of Git.
# Use AWS Secrets Manager/Parameter Store or a local untracked .env file.

