# Non-secret application defaults
DEFAULT_SEARCH_ZIP=02169

# Cognito configuration. These identify the user pool/app, not a user password.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Keep provider credentials out of this file and out of Git.
# Use AWS Secrets Manager/Parameter Store or a local untracked .env file.

